{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$RALPH_LOOP\" ] && exit 0; jq -r '.tool_input.command // \"\"' | grep -qE '(^|[;&|(] *)git push( |$)' && printf '%s\\n' '{\"hookSpecificOutput\":{\"hookEventName\":\"PostToolUse\",\"additionalContext\":\"A git push just ran, and Vercel builds every pushed branch. Tom wants the URL every time (CLAUDE.md): before replying, find the deployment with the Vercel connector (list_deployments, team slug eqlmax, projectId tidecaller, filtered by branch or sha) and give him the branch URL from list_deployment_aliases plus the deployment URL. The agent proxy blocks *.vercel.app, so never curl it.\"}}' || true",
            "timeout": 10,
            "statusMessage": "Checking for a Vercel deploy to report"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(scripts/ralph/ralph.sh:*)",
      "Bash(./scripts/ralph/ralph.sh:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git fetch:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git branch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git mv:*)",
      "Bash(git rm:*)",
      "Bash(git stash:*)",
      "Bash(git merge origin/main:*)",
      "Bash(git ls-remote:*)",
      "Bash(git rev-parse:*)",
      "Bash(git push -u origin HEAD:*)",
      "Bash(git push origin HEAD:*)",
      "Bash(git push -u origin claude/:*)",
      "Bash(git push origin claude/:*)",
      "Bash(jq:*)",
      "Bash(node:*)",
      "Bash(npm ci:*)",
      "Bash(npm install:*)",
      "Bash(npm run:*)",
      "Bash(npm test:*)",
      "Bash(npm ls:*)",
      "Bash(npm view:*)",
      "Bash(npx tsc:*)",
      "Bash(npx vitest:*)",
      "Bash(npx vite:*)",
      "Bash(CHROMIUM_PATH=/opt/pw-browsers/chromium-1194/chrome-linux/chrome npm run smoke:*)"
    ],
    "deny": [
      "Bash(git push origin main:*)",
      "Bash(git push -u origin main:*)",
      "Bash(git push origin HEAD:main:*)",
      "Bash(git push -u origin HEAD:main:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git rebase:*)",
      "Bash(git reset --hard:*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./.vercel/**)"
    ]
  }
}
